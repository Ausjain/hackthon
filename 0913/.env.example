# Places API (New) 웹 서비스용 서버 키
# IP 주소 제한과 Places API (New) API 제한을 적용하세요.
GOOGLE_PLACES_API_KEY=your_server_places_api_key

# Maps JavaScript API용 브라우저 키
# HTTP 리퍼러 제한과 Maps JavaScript API 제한을 적용하세요.
GOOGLE_MAPS_BROWSER_KEY=your_browser_maps_api_key

PORT=4173

# Firebase (Firestore) 설정 - Firebase 콘솔 > 프로젝트 설정 > 앱에서 확인
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
